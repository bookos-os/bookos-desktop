tecla esc 700
comprobar emergente ninguna 16
# Exceso contra el límite cerrado: el primer avance contrario empieza a exponer.
deslizar inicio 3 16
deslizar avance 0 240 16
deslizar avance 0 -60 50
captura
deslizar cancelar 700
# Se pasa del extremo abierto y se invierte sin deshacer el exceso invisible.
pellizcar inicio 5 16
pellizcar avance 0.3 16
pellizcar avance 0.35 50
captura
